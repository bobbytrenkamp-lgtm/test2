# Deploy-time configuration read by the systemd units themselves — which
# image tag to pull and run. Not application configuration, and never passed
# into a container (see infrastructure/systemd/api.env.example for that).
#
# Copy to /etc/cre-platform/deploy.env with the real, lowercase owner/repo
# path (GHCR requires lowercase image names) and keep it out of version
# control.
CRE_API_IMAGE=ghcr.io/OWNER/REPO-api:latest
CRE_WEB_IMAGE=ghcr.io/OWNER/REPO-web:latest

# Pin to a specific commit instead of `:latest` for a deployment that should
# not move until told to — .github/workflows/publish-images.yml tags every
# image with both `latest` and the commit SHA it was built from. Rolling back
# is then: set these to the previous SHA's tag, then
#   systemctl restart cre-api cre-worker cre-web
