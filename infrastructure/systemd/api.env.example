# Application environment for the API and worker containers, passed in via
# `docker run --env-file` (see cre-api.service / cre-worker.service). Copy to
# /etc/cre-platform/api.env, fill in real values, and `chmod 600` it —
# SESSION_SECRET and DATABASE_URL are credentials.
#
# See docs/deployment-guide.md's Environment table for the full variable
# list and what each one does. Only the ones a real deployment must set, or
# is likely to want different from the process's own default, are listed
# here.

NODE_ENV=production
DATABASE_URL=postgres://cre:CHANGE_ME@db.internal:5432/cre_platform
API_PORT=4000

# The public hostname this deployment is served from — the same origin
# infrastructure/nginx/production.conf.example terminates TLS for, so the
# session cookie stays first-party (docs/deployment-guide.md, Production
# topology).
WEB_ORIGIN=https://example.invalid

# 32+ characters. Generate with e.g. `openssl rand -base64 32`. Rotating this
# invalidates every session.
SESSION_SECRET=CHANGE_ME_32_CHARACTERS_MINIMUM

# Enforced at startup — the process refuses to start with this false under
# NODE_ENV=production. TLS is terminated in front of this deployment by
# infrastructure/nginx/production.conf.example, which is what makes `true`
# correct here.
SESSION_COOKIE_SECURE=true

# Matches the -v /var/lib/cre-platform/uploads:/data/uploads mount in
# cre-api.service and cre-worker.service — without both the mount and this
# variable, uploaded documents would not survive a redeploy.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/uploads

# Defaults below match the process's own out-of-the-box behaviour. Uncomment
# and change only what this deployment needs to differ from it.
# ALLOW_SELF_REGISTRATION=true
# AI_ASSISTANT_PROVIDER=none
# MAIL_DRIVER=console
# MAIL_FROM=no-reply@example.invalid
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SCAN_DRIVER=none
# SCAN_HOST=clamav
# SCAN_PORT=3310
