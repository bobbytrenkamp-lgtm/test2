# API image. The worker shares this image and differs only in its command, so
# the two can never drift apart on dependency or engine version.
#
# No `# syntax=` directive: it would pull a BuildKit frontend image on every
# build, and nothing here needs a feature the built-in frontend lacks.
#
# Base image via mirror.gcr.io, not docker.io, because the network policy this
# was built under allows Google's public read-through cache of Docker Hub's
# official images but blocks Docker Hub's own blob CDN outright (see
# docs/deployment-guide.md). It is the same publisher, same image, same
# content — mirror.gcr.io is a transparent cache, not a different build —
# so this is a reachability workaround, not a supply-chain change. Point this
# at `node:22-alpine` directly if building somewhere docker.io is reachable.
FROM mirror.gcr.io/library/node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
# Every workspace member's manifest, because pnpm-workspace.yaml globs apps/*
# and packages/*, and `--frozen-lockfile` compares the lockfile against the
# full set of importers. Omitting one makes the lockfile look stale and fails
# the install.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/domain-models/package.json packages/domain-models/
COPY packages/calculation-engine/package.json packages/calculation-engine/
COPY packages/database/package.json packages/database/
COPY packages/reporting/package.json packages/reporting/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
# `--frozen-lockfile` with no fallback. A build that quietly resolves different
# versions than the ones the test suite ran against is worse than a failed one,
# because it produces an artefact nobody has tested and says nothing about it.
RUN pnpm install --frozen-lockfile --ignore-scripts --prod=false

FROM base AS runtime
ENV NODE_ENV=production
# The worker's server-side PDF rendering (apps/worker/src/pdf.ts) needs a
# real Chromium. Playwright's own browser download targets glibc; this image
# is musl-based (node:22-alpine), so it is skipped in favour of Alpine's own
# chromium package, built for musl, and CHROMIUM_EXECUTABLE_PATH points
# playwright-core at it instead of the browser it would otherwise try to
# manage itself. The API image carries this too, unused, rather than
# maintaining a second Dockerfile — see the comment at the top of this file
# on why the two images are kept identical.
RUN apk add --no-cache chromium
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Dependencies first, then source. The installed tree is not overwritten by the
# copies below because .dockerignore keeps host node_modules out of the context.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker

# Run as an unprivileged user.
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@cre/api", "run", "start"]
