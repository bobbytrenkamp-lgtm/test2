# Host-level TLS-terminating reverse proxy for a production deployment.
#
# Deliberately separate from infrastructure/nginx.conf, which is baked into
# the `web` image and only ever runs over plain HTTP on the docker network —
# infrastructure/systemd/cre-web.service binds that container to
# 127.0.0.1:8080 for exactly this reason: nothing but this proxy is meant to
# reach it directly.
#
# TLS via certbot (Let's Encrypt) — free, no payment method, consistent with
# docs/zero-cost-operation.md. Install certbot, then:
#   certbot certonly --webroot -w /var/www/certbot -d example.invalid
# and enable its own systemd timer (`systemctl enable --now certbot.timer`,
# or whatever the distribution's certbot package registers) for renewal —
# nothing here needs to drive that itself.
#
# Copy to /etc/nginx/sites-available/cre-platform, symlink into
# sites-enabled, replace example.invalid throughout with the real hostname,
# and reload nginx.

server {
  listen 80;
  listen [::]:80;
  server_name example.invalid;

  # certbot's HTTP-01 challenge writes here when it issues or renews.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name example.invalid;

  ssl_certificate     /etc/letsencrypt/live/example.invalid/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

  # The web container serves the static client and proxies /api/ to the api
  # container itself (infrastructure/nginx.conf) — this layer's only job is
  # to terminate TLS and forward to that one origin, which is what keeps the
  # session cookie first-party end to end (docs/deployment-guide.md,
  # Production topology: "Serve the web client and API from the same
  # hostname").
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 20m;
  }
}
