# ---------------------------------------------------------------------------
# CRE Platform - example environment file.
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL connection string used by the API, worker and migration tooling.
DATABASE_URL=postgres://cre:cre@localhost:5432/cre_platform

# API server
API_PORT=4000
API_HOST=0.0.0.0

# Public origin of the web client, used for CORS and cookie configuration.
WEB_ORIGIN=http://localhost:5173

# 32+ byte random secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# Set to "true" only behind HTTPS. Controls the Secure flag on session cookies.
SESSION_COOKIE_SECURE=false

# Object storage abstraction. "local" writes to STORAGE_LOCAL_DIR.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Optional AI assistant. Disabled unless a provider is explicitly configured.
# No paid provider is bundled; see docs/architecture.md.
AI_ASSISTANT_PROVIDER=none
